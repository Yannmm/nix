{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "bailian": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Alibaba Bailian",
      "options": {
        "baseURL": "{env:OPENCODE_BASE_URL}",
        "apiKey": "{env:OPENCODE_API_KEY}"
      },
      "models": {
        "kimi/kimi-k3": {
          "name": "Kimi K3",
          "reasoning": true,
          "input": [
            "text",
            "image"
          ],
          "limit": {
            "context": 1048576,
            "output": 8192
          }
        },
        "glm-5.2": {
          "name": "GLM 5.2",
          "reasoning": true,
          "input": [
            "text",
            "image"
          ],
          "limit": {
            "context": 1048576,
            "output": 8192
          }
        },
        "qwen3.8-max": {
          "name": "Qwen3.8 Max",
          "reasoning": true,
          "input": [
            "text",
            "image"
          ],
          "limit": {
            "context": 1048576,
            "output": 8192
          }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "reasoning": true,
          "input": [
            "text",
            "image"
          ],
          "limit": {
            "context": 1048576,
            "output": 8192
          }
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "reasoning": true,
          "input": [
            "text",
            "image"
          ],
          "limit": {
            "context": 1048576,
            "output": 8192
          }
        }
      }
    }
  },
  "model": "bailian/qwen3.8-max",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer ctx7sk-dad81fa6-362d-46a2-926b-b31efbf0e81a"
      }
    }
  }
}
