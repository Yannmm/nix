{
  "env": {
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-4-5-20251001",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-4-6-v1",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-4-6-v1",
    "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1"
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./*.pem)",
      "Read(./*.key)",
      "Read(./*.pfx)",
      "Read(./*.p12)"
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    },
    "align-claude-code-marketplace": {
      "source": {
        "source": "git",
        "url": "git@github.com:align-primary/all-align-claude-code-marketplace.git"
      }
    }
  },
  "companyAnnouncements": [
    "You are using Align Cloud Platform Claude Code POC.",
    "Share your experiences at https://cloud.wiki.aligntech.com/wiki/x/DBzlCw"
  ],
  "autoUpdatesChannel": "stable",
  "theme": "auto"
}
